# ─── RQIS Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real credentials.
#
# CI will fail if a secret pattern is detected in a commit (secret scanning
# is enabled in GitHub Actions). See C5 in PRD.md.

# ─── PostgreSQL / TimescaleDB ────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ─── Object Storage (MinIO) ──────────────────────────────────────────────────
MINIO_ACCESS_KEY=rqis_minio_user
MINIO_SECRET_KEY=change_me_minio_password

# MinIO bucket names (created automatically on first run)
MINIO_BUCKET_RAW=rqis-raw
MINIO_BUCKET_SNAPSHOTS=rqis-snapshots
MINIO_BUCKET_MLFLOW=mlflow

# ─── Application database URL ────────────────────────────────────────────────
# Used by Python application code and Alembic migrations.
DATABASE_URL=postgresql+psycopg2://rqis:change_me_strong_password@localhost:5432/rqis

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO (application) ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
# MINIO_USE_SSL=false  (set to true in production)

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Airflow ─────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=generate_a_real_fernet_key_here
AIRFLOW_ADMIN_EMAIL=admin@rqis.local
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_password

# ─── Market Data ─────────────────────────────────────────────────────────────
# Phase 1: yfinance (no key needed — leave blank)
# Phase 2+: Polygon.io
POLYGON_API_KEY=

# ─── Broker — IBKR ───────────────────────────────────────────────────────────
# IMPORTANT: Port determines paper vs. live trading.
#   7497 = paper trading (TWS paper session)
#   7496 = live trading  (TWS live session)
# Changing PAPER_TRADING from "true" to "false" is a C9 destructive action
# and requires explicit "YES" confirmation. See PRD.md C9.
#
# IBKR_HOST is used by host-side operator CLI scripts (scripts/paper_*_check.py
# etc.) that run directly on the same machine as TWS/IB Gateway. 127.0.0.1 is
# correct there. Never set IBKR_HOST=127.0.0.1/localhost for a containerized
# caller — see IBKR_HOST_AIRFLOW below (BUG-004).
IBKR_HOST=127.0.0.1
# IBKR_HOST_AIRFLOW is the Docker-safe host used only inside the Airflow
# Compose containers (bridged `rqis` network), which cannot reach TWS/IB
# Gateway via 127.0.0.1 because that resolves to the container itself.
#   Windows / Mac Docker Desktop: host.docker.internal (default below; the
#     daemon publishes this name automatically, and docker-compose.yml also
#     adds an explicit extra_hosts mapping for portability).
#   Linux Docker Engine: host.docker.internal resolves via the
#     `extra_hosts: ["host.docker.internal:host-gateway"]` entry in
#     docker-compose.yml on Docker Engine >=20.10 / Compose 3.x+; verify this
#     on your Compose version before relying on it, and fall back to an
#     explicit gateway/host IP address (e.g. the docker0 bridge IP or a LAN
#     IP reachable from the container) if host-gateway is unsupported.
# execution/brokers/ibkr.py rejects an unset/empty/loopback value here inside
# any container with a non-empty RQIS_RUNTIME_CONTEXT set (BUG-004); there is
# no silent fallback to 127.0.0.1, and unrecognized non-empty context values
# are also enforced fail-closed.
IBKR_HOST_AIRFLOW=host.docker.internal
# Escape hatch for a deliberately host-networked container deployment ONLY:
# setting RQIS_RUNTIME_NETWORK_MODE=host inside such a container re-allows a
# loopback IBKR_HOST despite RQIS_RUNTIME_CONTEXT being set. Never set this
# on the default bridged Compose stack.
# RQIS_RUNTIME_NETWORK_MODE=host
# NOTE: the Airflow Compose services HARD-CODE PAPER_TRADING=true and
# IBKR_PORT=7497 (paper) in docker-compose.yml -- the two values below are
# consumed only by host-side CLI scripts, and cannot flip the Compose stack
# to live mode.
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Optional explicit FX fallback when IBKR account NAV is in CAD but USD risk math
# is required and the account lacks IBKR FX market data permissions.
# Both values are required if used; stale AS_OF dates are rejected by the broker.
# IBKR_FX_RATE_CAD_USD=<current CAD-to-USD rate>
# IBKR_FX_RATE_CAD_USD_AS_OF=<YYYY-MM-DD>
PAPER_TRADING=true

# ─── Paper-trading artifact storage (BUG-003) ────────────────────────────────
# RQIS_PAPER_ARTIFACT_HOST_DIR is the host filesystem path bind-mounted into
# every Airflow Compose service at the fixed in-container path
# /opt/airflow/rqis_paper (see docker-compose.yml x-airflow-common). It is the
# same directory the host-side Streamlit dashboard/approval tooling reads
# blotter artifacts from — there is no Compose dashboard service (see
# docs/streamlit_dashboard_spec.md and docs/runbooks/).
#
# When launching the dashboard on the host (`streamlit run
# reporting/dashboards/app.py`), export RQIS_PAPER_ARTIFACT_DIR set to THIS
# SAME path (the host path, not the container path /opt/airflow/rqis_paper)
# so it resolves the identical bind-mounted files:
#   set RQIS_PAPER_ARTIFACT_DIR=%RQIS_PAPER_ARTIFACT_HOST_DIR%   (cmd.exe)
#   $env:RQIS_PAPER_ARTIFACT_DIR = $env:RQIS_PAPER_ARTIFACT_HOST_DIR  (PowerShell)
RQIS_PAPER_ARTIFACT_HOST_DIR=./local/paper_artifacts

# ─── Monitoring ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password
# Prometheus pushgateway (optional — for short-lived jobs)
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# ─── Alerting ────────────────────────────────────────────────────────────────
# Slack webhook for breach notifications (optional)
SLACK_WEBHOOK_URL=
# Email for Airflow failure alerts
ALERT_EMAIL=

# ─── Application Settings ────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Environment label shown in dashboards and logs
ENVIRONMENT=development
