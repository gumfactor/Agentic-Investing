FROM ghcr.io/mlflow/mlflow:v2.10.2

# The base MLflow image ships neither psycopg2 nor boto3.
# psycopg2-binary : required for --backend-store-uri postgresql+psycopg2://...
# boto3           : required for --artifacts-destination s3://... (MinIO speaks S3)
RUN pip install --no-cache-dir psycopg2-binary boto3
